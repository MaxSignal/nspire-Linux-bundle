#!/bin/sh
# First process. Use the persistent root filesystem when the loader set one
# up (nspire_tifs.path=... on the command line): format it on its first boot
# and fill it, then switch to it. Otherwise run from RAM.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# To the kernel log: shown on every console, and kept in dmesg
say() { echo "init: $*" > /dev/kmsg 2>/dev/null || echo "init: $*"; }

# The root filesystem comes as an archive (OpenWrt) or is this initramfs
# itself. The archive is in this initramfs, or, too large for the RAM the
# loader has, it is the payload the loader wrote into a new image (named in
# /payload-name), taken out before the image is formatted.
archive=
[ -f /payload/rootfs.tar.gz ] && archive=/payload/rootfs.tar.gz
payload=$(cat /payload-name 2>/dev/null)

get_payload() {
	[ -n "$archive" ] || [ -z "$payload" ] && return 0
	say "reading $payload from the image"
	if nspire-payload /dev/tifs0 > /run/rootfs.tar.gz; then
		archive=/run/rootfs.tar.gz
	else
		rm -f /run/rootfs.tar.gz
		say "the image does not hold $payload: delete it from the TI-Nspire file browser and boot again"
	fi
}

# Fill a new root filesystem
populate() {
	if [ -n "$archive" ]; then
		say "unpacking $(basename "${payload:-the root filesystem}" .tar.gz)"
		tar -xzf "$archive" -C "$1" || return 1
	elif [ -n "$payload" ]; then
		return 1
	else
		for e in /*; do
			case "$e" in
			/proc|/sys|/dev|/newroot|/payload) mkdir -p "$1$e" ;;
			/rootfs-kib|/payload-name) ;;
			*) cp -a "$e" "$1/" || return 1 ;;
			esac
		done
	fi
	mkdir -p "$1/proc" "$1/sys" "$1/dev" "$1/tmp" "$1/root"
	sync && touch "$1/.nspire-installed" && sync
}

switch_to() {
	for m in /dev /proc /sys; do
		mount -o move $m "$1$m" 2>/dev/null || umount $m
	done
	exec switch_root "$1" /sbin/init
}
boot_ram() {
	if [ -n "$archive" ]; then
		mount -t tmpfs -o size=75% tmpfs /newroot && populate /newroot &&
			rm -f /run/rootfs.tar.gz && switch_to /newroot
	elif [ -n "$payload" ]; then
		say "without $payload, only a minimal shell"
	fi
	exec /sbin/init
}

path=$(sed -n 's/.*nspire_tifs\.path=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -z "$path" ] || grep -qw nspire.ramroot /proc/cmdline; then
	boot_ram
fi

say "waiting for the Linux image $path"
n=0
grep -q '"filesystem"' /proc/mtd || n=180
while [ ! -b /dev/tifs0 ] && [ $n -lt 180 ]; do
	dmesg | grep -q "nspire-tifs: not attached" && break
	sleep 1
	n=$((n + 1))
done
if [ ! -b /dev/tifs0 ]; then
	say "no Linux image (see dmesg | grep tifs), running from RAM"
	boot_ram
fi

ro=$(cat /sys/block/tifs0/ro)
# No ext2 superblock magic: a new image (it holds the loader's tags)
if [ "$(hexdump -s 1080 -n 2 -e '1/2 "%04x"' /dev/tifs0)" != ef53 ]; then
	get_payload
	if [ "$ro" = 1 ]; then
		say "the image is read-only and not formatted (see dmesg | grep tifs), running from RAM"
		boot_ram
	fi
	# Too small for this system: leave it new, so that the loader can
	# still grow it
	need=$(cat /rootfs-kib 2>/dev/null || echo 0)
	size=$(($(cat /sys/block/tifs0/size) / 2))
	if [ "$size" -lt "$need" ]; then
		say "the image is too small for this system ($size KiB, $need KiB needed), running from RAM"
		boot_ram
	fi
	[ -n "$payload" ] && [ -z "$archive" ] && boot_ram
	say "first boot: formatting $path"
	mkfs.ext2 -q -L nspire-linux /dev/tifs0 && mount -t ext2 /dev/tifs0 /newroot &&
		populate /newroot || {
		say "setting up the image failed, running from RAM"
		umount /newroot 2>/dev/null
		boot_ram
	}
	rm -f /run/rootfs.tar.gz
else
	mount -t ext2 -o "$([ "$ro" = 1 ] && echo ro || echo rw)" /dev/tifs0 /newroot || {
		say "cannot mount the image, running from RAM"
		boot_ram
	}
	[ "$ro" = 1 ] && say "the image is read-only (see dmesg | grep tifs)"
	# Interrupted while filling it the first time: fill it again (a
	# payload went with the formatting: the image has to be made again)
	if [ ! -e /newroot/.nspire-installed ] && [ "$ro" = 0 ]; then
		say "finishing the setup of $path"
		populate /newroot || {
			say "setting up the image failed: delete it from the TI-Nspire file browser and boot again; running from RAM"
			umount /newroot
			boot_ram
		}
	fi
fi

# Never switch to a root that cannot start: init would end, and the kernel
# with it
if [ ! -e /newroot/.nspire-installed ] || [ ! -x /newroot/sbin/init ]; then
	say "the image is not set up completely (see dmesg | grep tifs), running from RAM"
	umount /newroot
	boot_ram
fi
switch_to /newroot
