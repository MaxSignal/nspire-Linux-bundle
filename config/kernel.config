# Added to multi_v4t_defconfig + nspire.config for the bundle:
# the root filesystem comes as an initrd (cpio.gz) loaded by linuxloader2.
CONFIG_LOCALVERSION="-nspire"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
# A small font for the 320x240 screen (selected with fbcon=font:6x8)
CONFIG_FONTS=y
CONFIG_FONT_6x8=y
CONFIG_FONT_8x16=y
# Persistent root filesystem: an image file of the TI-Nspire OS filesystem
CONFIG_MTD_NSPIRE_TIFS=y
CONFIG_EXT2_FS=y
# Networking, as OpenWrt expects it, and an Ethernet link to a computer over
# USB (CDC NCM) as usb0
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_NCM=y
