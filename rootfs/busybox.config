# The whole BusyBox configuration, applied on top of "allnoconfig":
# only what the boot environment and an interactive shell need.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_DEVPTS=y
# Shell
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=512
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_CTTYHACK=y
# Init and consoles
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_GETTY=y
CONFIG_SWITCH_ROOT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_STTY=y
CONFIG_CLEAR=y
CONFIG_RESET=y
# Filesystems
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_MOUNTPOINT=y
CONFIG_MKE2FS=y
CONFIG_MKFS_EXT2=y
CONFIG_DF=y
CONFIG_DU=y
CONFIG_SYNC=y
# Swap in RAM (zram), set up by nspire-zram
CONFIG_MKSWAP=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y
# Files and text
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PWD=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_TR=y
CONFIG_CUT=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_GREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_SED=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_XARGS=y
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=y
CONFIG_LESS=y
CONFIG_HEXDUMP=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_GUNZIP=y
CONFIG_GZIP=y
# System
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_TOP=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_DMESG=y
CONFIG_UNAME=y
CONFIG_HOSTNAME=y
CONFIG_DATE=y
CONFIG_HWCLOCK=y
CONFIG_SLEEP=y
CONFIG_ENV=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_WHICH=y
CONFIG_DEVMEM=y
CONFIG_NANDDUMP=y
CONFIG_INSMOD=y
CONFIG_RMMOD=y
CONFIG_LSMOD=y
# Network: Ethernet over USB (usb0) as a DHCP client
CONFIG_FEATURE_IPV6=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_UDHCPC=y
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_NSLOOKUP=y
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_FEATURE_WGET_HTTPS=y
